CREATE TABLE regions (id integer PRIMARY KEY, name text NOT NULL);
CREATE TABLE categories (id integer PRIMARY KEY, name text NOT NULL);
CREATE TABLE customers (id integer PRIMARY KEY, name text NOT NULL, email text NOT NULL UNIQUE, region_id integer REFERENCES regions(id), created_at date NOT NULL);
CREATE TABLE products (id integer PRIMARY KEY, name text NOT NULL, category_id integer REFERENCES categories(id), price numeric(12,2) NOT NULL CHECK(price >= 0), cost numeric(12,2) NOT NULL, created_at date NOT NULL);
CREATE TABLE orders (id integer PRIMARY KEY, customer_id integer REFERENCES customers(id), order_date date NOT NULL, status text NOT NULL, total_amount numeric(14,2) NOT NULL DEFAULT 0);
CREATE TABLE order_items (id integer PRIMARY KEY, order_id integer REFERENCES orders(id), product_id integer REFERENCES products(id), quantity integer NOT NULL CHECK(quantity > 0), unit_price numeric(12,2) NOT NULL, discount numeric(4,2) NOT NULL CHECK(discount BETWEEN 0 AND 1));
CREATE TABLE employees (id integer PRIMARY KEY, name text NOT NULL, department text NOT NULL, salary numeric(12,2) NOT NULL, hire_date date NOT NULL);
INSERT INTO regions VALUES (1,'North'),(2,'South'),(3,'East'),(4,'West');
INSERT INTO categories VALUES (1,'Electronics'),(2,'Home'),(3,'Sports'),(4,'Books'),(5,'Clothing');
INSERT INTO customers SELECT n, 'Customer ' || n, 'customer' || n || '@example.test', 1+n%4, CURRENT_DATE-(n%900) FROM generate_series(1,600) n;
INSERT INTO products SELECT n, (ARRAY['Electronics','Home','Sports','Books','Clothing'])[1+n%5] || ' Product ' || n, 1+n%5, 100+(n*73)%20000, (100+(n*73)%20000)*0.6, CURRENT_DATE-(n%700) FROM generate_series(1,120) n;
INSERT INTO orders (id,customer_id,order_date,status) SELECT n, 1+(n*17)%600, CURRENT_DATE-(n%730), (ARRAY['completed','completed','completed','pending','cancelled'])[1+n%5] FROM generate_series(1,4000) n;
INSERT INTO order_items SELECT n, 1+(n-1)/3, 1+(n*19)%120, 1+n%5, p.price, (n%4)*0.05 FROM generate_series(1,12000) n JOIN products p ON p.id=1+(n*19)%120;
UPDATE orders o SET total_amount = x.amount FROM (SELECT order_id, SUM(quantity*unit_price*(1-discount)) amount FROM order_items GROUP BY order_id) x WHERE o.id=x.order_id;
INSERT INTO employees SELECT n,'Employee ' || n,(ARRAY['Sales','Engineering','Operations'])[1+n%3],30000+n*1700,CURRENT_DATE-(n*41) FROM generate_series(1,40) n;
CREATE INDEX ON orders(order_date);
CREATE INDEX ON orders(customer_id);
CREATE INDEX ON order_items(order_id);
CREATE INDEX ON order_items(product_id);
REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO analyst;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO analyst;
REVOKE TEMPORARY ON DATABASE business FROM PUBLIC;
ANALYZE;
