#!/bin/sh
# Explicit maintenance command; not run automatically by PostgreSQL initialization.
# Preserve data while aligning local role passwords with the Compose environment.
set -eu
psql -v ON_ERROR_STOP=1 --username "${POSTGRES_USER:-postgres}" --dbname postgres \
  --set=admin_password="$POSTGRES_PASSWORD" \
  --set=metadata_password="$METADATA_PASSWORD" \
  --set=readonly_password="$READONLY_PASSWORD" <<'SQL'
ALTER ROLE postgres PASSWORD :'admin_password';
ALTER ROLE metadata PASSWORD :'metadata_password';
ALTER ROLE analyst PASSWORD :'readonly_password';
SQL
