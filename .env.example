POSTGRES_PASSWORD=replace_with_local_admin_password
METADATA_PASSWORD=replace_with_local_metadata_password
READONLY_PASSWORD=replace_with_local_readonly_password
DATABASE_URL=postgresql+psycopg://metadata:replace_with_local_metadata_password@localhost:5432/metadata
READONLY_DATABASE_URL=postgresql+psycopg://analyst:replace_with_local_readonly_password@localhost:5432/business
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=qwen3:8b
MAX_RESULT_ROWS=1000
MAX_ESTIMATED_ROWS=1000000
MAX_ESTIMATED_COST=100000
MAX_QUERY_SECONDS=10
MAX_SUBQUERY_DEPTH=3
VALIDATION_MODE=strict
EMBEDDING_MODEL=all-MiniLM-L6-v2
SPEECH_MODEL=tiny.en
SPEECH_MODEL_DIR=~/.cache/texttosql/speech
